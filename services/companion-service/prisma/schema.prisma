generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Companion service reads/writes only avatar_config, personality_archetype,
// communication_style from the shared users table
model User {
  id                   String   @id @default(uuid()) @db.Uuid
  email                String   @unique
  username             String   @unique
  hashedPassword       String   @map("hashed_password")
  personalityArchetype String   @default("friend") @map("personality_archetype")
  avatarConfig         Json     @default("{}") @map("avatar_config")
  communicationStyle   String   @default("casual") @map("communication_style")
  isActive             Boolean  @default(true) @map("is_active")
  isVerified           Boolean  @default(false) @map("is_verified")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("users")
}
